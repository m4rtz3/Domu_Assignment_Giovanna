# Copy this file to ".env" (same folder) and fill in your real key.
# Never commit the real .env file — it's already in .gitignore.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default model. Defaults to claude-sonnet-5 if unset.
# For a real-time voice product, a faster/cheaper model (e.g. a Haiku-class
# model) would likely be used instead — see SCOPE_OF_WORK.md for the tradeoff.
ANTHROPIC_MODEL=claude-sonnet-5

# Set to true to skip real LLM calls and use canned demo responses instead.
# Handy for developing/demoing the frontend without a working API key, or
# without spending API credits on every click. Set back to false (or remove)
# once you have a working key and want real generations.
LLM_MOCK_MODE=false
